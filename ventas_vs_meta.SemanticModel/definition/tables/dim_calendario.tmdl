		annotation SummarizationSetBy = Automatic

	/// Verdadero hasta el último día con ventas (29 ago 2018). Lo usan las medidas de tiempo.
	column con_ventas = dim_calendario[fecha] <= MAX ( fact_ventas[fecha] )
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 3a761eee-dc1d-451a-873d-880bd28c9ca4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = calculated
		mode: import
		source =
				
				VAR base = CALENDAR ( DATE ( 2017, 1, 1 ), DATE ( 2018, 12, 31 ) )
				RETURN
				    ADDCOLUMNS (
				        SELECTCOLUMNS ( base, "fecha", [Date] ),
				        "anio", YEAR ( [fecha] ),
				        "mes_num", MONTH ( [fecha] ),
				        "mes", FORMAT ( [fecha], "mmm" ),
				        "anio_mes", FORMAT ( [fecha], "yyyy-mm" ),
				        "inicio_mes", DATE ( YEAR ( [fecha] ), MONTH ( [fecha] ), 1 ),
				        "trimestre", "T" & QUARTER ( [fecha] ),
				        "es_dia_habil", IF ( WEEKDAY ( [fecha], 2 ) <= 5, 1, 0 )
				    )

	annotation PBI_Id = cddb3b41a1be40c481d75623e5ba95f4

